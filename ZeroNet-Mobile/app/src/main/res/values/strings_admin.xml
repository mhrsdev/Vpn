    <!-- Huawei router (Design G: H158-381 as an L2TP VPN client) -->
    <string name="hw_title">Huawei router (H158-381)</string>
    <string name="hw_no_caps">The backend has not published this modem\u2019s capabilities yet. Nothing here is guessed — check back after the router support lands.</string>
    <string name="hw_protocols">VPN client support</string>
    <string name="hw_consent_title">Before any credential is shown</string>
    <string name="hw_consent">I understand the modem link is Weak, not modern-VPN-grade</string>
    <string name="hw_consent_detail">This modem\u2019s stock firmware only offers L2TP (and PPTP, which we refuse). L2TP with mandatory MPPE-128 defeats casual snooping but NOT a determined network observer. The Iran\u2194USA tunnel and everything past the gateway keep full modern encryption — only the modem\u2192gateway leg is weak.</string>
    <string name="hw_consent_required">Tick the consent checkbox above first — no credential is shown without it.</string>
    <string name="hw_accounts">Modem accounts</string>
    <string name="hw_no_accounts">No modem accounts yet. Create one per modem — each gets its own PPP login and can be revoked independently.</string>
    <string name="hw_new_account">New modem account</string>
    <string name="hw_account_name_hint">e.g. home-5g</string>
    <string name="hw_create">Create account</string>
    <string name="hw_show_creds">Show credentials</string>
    <string name="hw_rotate">Rotate password</string>
    <string name="hw_revoke">Revoke account</string>
    <string name="hw_status_connected">Connected now</string>
    <string name="hw_status_last_seen">Last seen %1$s</string>
    <string name="hw_status_never">Never connected</string>
    <string name="hw_data_used">Data used: %1$s</string>
    <string name="hw_credentials">Modem credentials</string>
    <string name="hw_reveal">Reveal</string>
    <string name="hw_hide">Hide</string>
    <string name="hw_guide">Step-by-step guide</string>
    <string name="hw_load_guide">Load guide</string>
    <string name="hw_no_guide">No guide published yet. The guide is written from the modem\u2019s real firmware — it appears here once the backend publishes it.</string>
    <string name="hw_security">Security status</string>
    <string name="hw_check_security">Check security</string>
    <string name="hw_no_findings">No security assessment yet. Run the check to see what the backend reports about this modem\u2019s setup.</string>
    <string name="hw_limits">Honest limitations</string>
    <string name="hw_limit_killswitch">No kill switch: if the L2TP session drops, the modem routes traffic directly over the mobile network until it reconnects. This panel shows live status but cannot prevent the fallback.</string>
    <string name="hw_limit_crypto">Weak link crypto: L2TP + MPPE-128 resists casual snooping, not a determined observer. Only the modem\u2192gateway leg is weak.</string>
    <string name="hw_limit_fulltunnel">Full-tunnel behavior is unverified on the real unit: after connecting, check from a LAN device that your public IP is the VPN exit IP, not the operator\u2019s.</string>
    <string name="hw_limit_ipv6">IPv6 bypass risk: if your mobile plan uses IPv6, set the modem\u2019s APN to IPv4-only while the VPN is active.</string>
    <string name="hw_limit_speed">Throughput ceiling: the modem forwards VPN traffic in software — expect well under the 5G radio rate (older models capped around 50 Mbps).</string>
    <string name="hw_limit_single">Single VPN session: no multi-protocol, no smart failover on the modem itself. All intelligence lives on the Iran gateway.</string>
    <string name="hw_limit_dns">DNS control is partial: we push DNS over PPP, but a LAN device with hardcoded DNS (DoH, manual DNS) bypasses it.</string>
    <string name="hw_limit_firmware">Firmware variance: operator-branded builds may rename or hide the VPN page (official path: Advanced \u003e Route \u003e VPN). If your unit\u2019s menu looks different, tell the administrator instead of guessing.</string>
    <string name="hw_limit_remote">No remote management: this panel generates credentials and guides — it cannot push configuration into the modem.</string>

